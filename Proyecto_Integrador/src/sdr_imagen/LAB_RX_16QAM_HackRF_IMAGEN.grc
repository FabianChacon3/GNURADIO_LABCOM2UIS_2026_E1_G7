options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Recepcion de imagen por paquetes: sincronia, CRC32 por trama, reensamblado y guardado PNG, EVM, AGC y EQ
      opcional.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: LAB_RX_16QAM_HackRF_IMAGEN
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LAB RX 16-QAM HackRF - IMAGEN (CRC32 + reensamblado)
    window_size: (1500,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 96
    - 32.0
    rotation: 0
    state: enabled
blocks:
- name: M
  id: variable
  parameters:
    comment: ''
    value: len(tabla_de_verdad_constelacion)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 672
    - 8.0
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: ''
    value: Rs*bps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 80.0
    rotation: 0
    state: enabled
- name: Rs
  id: variable
  parameters:
    comment: ''
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 464
    - 16.0
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    comment: ''
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 568
    - 8.0
    rotation: 0
    state: enabled
- name: beta
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Roll-off beta
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.10'
    step: '0.05'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1360
    - 0.0
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters:
    comment: ''
    value: int(math.log(M,2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 856
    - 0.0
    rotation: 0
    state: enabled
- name: const_16qam
  id: variable_constellation
  parameters:
    comment: ''
    const_points: tabla_de_verdad_constelacion
    dims: '1'
    normalization: digital.constellation.POWER_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: list(range(16))
    type: calcdist
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1912
    - 20.0
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: 960 MHz, igual al Tx
    value: 960e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 488
    - 104.0
    rotation: 0
    state: enabled
- name: hackrf_rx
  id: variable
  parameters:
    comment: ''
    value: '"hackrf=0"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 288
    - 40.0
    rotation: 0
    state: enabled
- name: lo_off
  id: variable
  parameters:
    comment: ''
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1664
    - 152.0
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: ''
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1832
    - 128.0
    rotation: 0
    state: enabled
- name: noise_amp
  id: variable_qtgui_range
  parameters:
    comment: 'Sin aplicacion: AWGN de prueba se controla en el TX. Desactivado.'
    gui_hint: ''
    label: Amplitud de ruido AWGN
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.001'
    stop: '2.5'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1528
    - 8.0
    rotation: 0
    state: disabled
- name: radio_rate
  id: variable
  parameters:
    comment: ''
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1056
    - 168.0
    rotation: 0
    state: enabled
- name: rrc_tx_taps
  id: variable_rrc_filter_taps
  parameters:
    alpha: beta
    comment: ''
    gain: Sps
    ntaps: span*Sps
    samp_rate: samp_rate
    sym_rate: Rs
    value: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 0.0
    rotation: 0
    state: enabled
- name: rx_lna
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Rx IF gain / LNA HackRF (0-40 dB, pasos de 8)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '8'
    stop: '40'
    value: '16'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1280
    - 160.0
    rotation: 0
    state: enabled
- name: rx_vga
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Rx BB gain / VGA HackRF (0-62 dB, pasos de 2)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '2'
    stop: '62'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1472
    - 160.0
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: Rs*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1016
    - 0.0
    rotation: 0
    state: enabled
- name: span
  id: variable
  parameters:
    comment: ''
    value: '11'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1080
    - 80.0
    rotation: 0
    state: enabled
- name: tabla_de_verdad_constelacion
  id: variable
  parameters:
    comment: ''
    value: tuple(z/math.sqrt(10.0) for z in (-3-3j,-3-1j,-3+3j,-3+1j,-1-3j,-1-1j,-1+3j,-1+1j,3-3j,3-1j,3+3j,3+1j,1-3j,1-1j,1+3j,1+1j))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 608
    - 88.0
    rotation: 0
    state: enabled
- name: agc_entrada
  id: analog_agc_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'AGC1: limite razonable inicial, calibrar segun nivel de RF'
    gain: '1.0'
    max_gain: '500'
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: 1e-3
    reference: '1.0'
    type: complex
  states:
