  parameters:
    affinity: ''
    alias: ''
    comment: Estima y corrige el offset de frecuencia de portadora.
    filter_size: '44'
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: beta
    samps_per_sym: Sps
    type: cc
    w: 2*math.pi/400
