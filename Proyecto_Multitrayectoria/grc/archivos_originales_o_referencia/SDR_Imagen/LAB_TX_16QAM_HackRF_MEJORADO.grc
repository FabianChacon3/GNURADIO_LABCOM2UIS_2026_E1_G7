- name: tx_trama_crc
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: 64 simbolos preambulo + 48 bytes texto + CRC32 + 24 simbolos guarda; fuente autocontenida
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: "import numpy as np\nimport zlib\nfrom gnuradio import gr\n\n# 16-QAM Gray-indexed table, average symbol\
      \ energy Es = 1.\nPOINTS = np.asarray((\n    -3-3j, -3-1j, -3+3j, -3+1j,\n    -1-3j, -1-1j, -1+3j, -1+1j,\n     3-3j,\
      \  3-1j,  3+3j,  3+1j,\n     1-3j,  1-1j,  1+3j,  1+1j\n), dtype=np.complex64) / np.sqrt(10.0)\nPRE_LEN = 64\nPAY_LEN\
      \ = 48\nGUARD_LEN = 24\nPAYLOAD = b\"LAB GNU RADIO 16QAM HACKRF 2026\".ljust(PAY_LEN, b\" \")\n# Seed is fixed; TX and\
      \ RX use the same deterministic preamble.\nPREAMBLE = np.random.default_rng(20261029).integers(0, 16, PRE_LEN, dtype=np.uint8)\n\
      GUARD = np.random.default_rng(160116).integers(0, 16, GUARD_LEN, dtype=np.uint8)\nCRC = zlib.crc32(PAYLOAD).to_bytes(4,\
      \ 'big')\nPACKET = PAYLOAD + CRC\nPACKET_NIB = np.empty(2 * len(PACKET), dtype=np.uint8)\nPACKET_NIB[0::2] = np.frombuffer(PACKET,\
      \ dtype=np.uint8) >> 4\nPACKET_NIB[1::2] = np.frombuffer(PACKET, dtype=np.uint8) & 15\nFRAME = np.concatenate((PREAMBLE,\
      \ PACKET_NIB, GUARD)).astype(np.uint8)\n\n\nclass blk(gr.sync_block):\n    \"\"\"Transmit cyclic frames of known 16-QAM\
      \ symbol indices (0..15).\"\"\"\n    def __init__(self):\n        gr.sync_block.__init__(self, name='TX trama conocida\
      \ + CRC32',\n                               in_sig=None, out_sig=[np.uint8])\n        self.frame = FRAME\n        self.position\
      \ = 0\n        print('[TX] Frame: preamble 64 symbols + data 104 symbols + guard 24 symbols; ' +\n              '192\
      \ symbols, 768 total bits/frame')\n        print('[TX] Expected message:', PAYLOAD.rstrip().decode('ascii'))\n\n   \
      \ def work(self, input_items, output_items):\n        out = output_items[0]\n        n = len(out)\n        if n < 1:\n\
      \            return 0\n        positions = (self.position + np.arange(n, dtype=np.int64)) % len(self.frame)\n      \
      \  out[:] = self.frame[positions]\n        self.position = (self.position + n) % len(self.frame)\n        return n\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 270.0
    rotation: 0
    state: enabled
    _io_cache: ('TX trama conocida + CRC32', 'blk', [], [], [('0', 'byte', 1)], '', [])
