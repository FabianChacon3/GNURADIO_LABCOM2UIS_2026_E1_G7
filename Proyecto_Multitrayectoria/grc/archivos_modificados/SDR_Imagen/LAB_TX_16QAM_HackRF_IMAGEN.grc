- name: tx_imagen
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: "Convierte la imagen real a bytes y genera tramas 16-QAM con preambulo, cabecera, CRC32 y guarda. test_mode es falso por defecto."
    maxoutbuf: '0'
    minoutbuf: '0'
    test_mode: 'False'
    _source_code: |
      import os
      import struct
      import zlib
      import numpy as np
      from gnuradio import gr

      # ---------------------------------------------------------------------------
      # Protocolo de trama (identico en TX y RX):
      #   [PREAMBULO 64 simbolos] [CUERPO: cabecera 12 B + datos N B + CRC32 4 B,
      #   blanqueado con PRBS, 2 simbolos 16-QAM por byte] [GUARDA 24 simbolos]
      # Cabecera (big endian): seq u16, total u16, ancho u16, alto u16,
      #                        canales u8, bytes_utiles u8, id_imagen u16
      # La imagen se repite ciclicamente: el RX reconstruye aunque pierda paquetes.
      # ---------------------------------------------------------------------------
      PRE_LEN = 64
      GUARD_LEN = 24
      HDR_LEN = 12
      HDR_FMT = '>HHHHBBH'


      def prng(seed, n, bits):
          """xorshift32 determinista (no depende de la version de numpy)."""
          x = (seed & 0xFFFFFFFF) or 1
          mask = (1 << bits) - 1
          out = np.empty(n, dtype=np.uint8)
          for i in range(n):
              x ^= (x << 13) & 0xFFFFFFFF
              x ^= x >> 17
              x ^= (x << 5) & 0xFFFFFFFF
              out[i] = (x >> 16) & mask
          return out

      PREAMBLE = prng(20261029, PRE_LEN, 4)
      GUARD = prng(160116, GUARD_LEN, 4)

      def resolve_image_path(path):
          if os.path.isabs(path):
              return path
          module_path = globals().get('__file__')
          base = os.path.dirname(module_path) if module_path else os.getcwd()
          return os.path.abspath(os.path.join(base, path))

      def load_image(path, w, h, ch, test_mode=False):
          from PIL import Image, ImageDraw

          mode = 'RGB' if ch == 3 else 'L'
          resolved = resolve_image_path(path) if path else ''
          if resolved and os.path.isfile(resolved):
              with Image.open(resolved) as source:
                  if source.mode in ('RGBA', 'LA', 'P'):
                      source = source.convert('RGBA')
                      fondo = Image.new('RGBA', source.size, (255, 255, 255, 255))
                      source = Image.alpha_composite(fondo, source)
                  im = source.convert(mode).resize((w, h), Image.LANCZOS)
              print('[TX] Imagen cargada: %s -> %dx%d, %d canal(es)' %
                    (resolved, w, h, ch))
              return im

          if not test_mode:
              raise FileNotFoundError(
                  '[TX] No se encontro el PNG de entrada: %s. '
                  'Corrige image_path o activa test_mode solo para una prueba.'
                  % (resolved or str(path))
              )

          print('[TX] MODO PRUEBA explicito: se genera un patron sintetico.')
          im = Image.new('RGB', (w, h), (255, 255, 255))
          d = ImageDraw.Draw(im)
          colores = [(255, 0, 0), (0, 160, 0), (0, 0, 255),
                     (255, 200, 0), (0, 0, 0)]
          bw = max(1, w // len(colores))
          for i, c in enumerate(colores):
              d.rectangle([i * bw, 0, (i + 1) * bw - 1, h // 2], fill=c)
          if w > 2 and h > 2:
              x0 = min(2, w - 1)
              x1 = max(x0, w - 3)
              y0 = min(h - 1, h // 2 + 1)
              d.rectangle([x0, y0, x1, h - 1], outline=(0, 0, 0))
          d.text((min(8, w - 1), min(h // 2 + 2, h - 1)),
                 'PRUEBA 16-QAM', fill=(0, 0, 0))
          return im.convert(mode)

      class blk(gr.sync_block):
          """Transmite ciclicamente una imagen como tramas de indices 16-QAM (0..15)."""

          def __init__(self, image_path='../../../figures/escenario/Logouis.png',
                       width=160, height=80, channels=3, payload_len=128,
                       test_mode=False):
              gr.sync_block.__init__(self, name='TX imagen: tramas + CRC32',
                                     in_sig=None, out_sig=[np.uint8])
              self.image_path = image_path
              self.test_mode = bool(test_mode)
              self.width = int(width)
              self.height = int(height)
              self.channels = 3 if int(channels) == 3 else 1
              self.payload_len = int(payload_len)
              if not (1 <= self.payload_len <= 255):
                  raise ValueError('payload_len debe estar entre 1 y 255')
              if self.width > 65535 or self.height > 65535:
                  raise ValueError('ancho/alto demasiado grandes')

              self.frame_all = None
              self.position = 0

          def _prepare_frames(self):
              im = load_image(self.image_path, self.width, self.height,
                              self.channels, self.test_mode)
              data = im.tobytes()
              img_id = zlib.crc32(data) & 0xFFFF
              plen = self.payload_len
              npk = (len(data) + plen - 1) // plen
              whiten = prng(777123, HDR_LEN + plen + 4, 8)

              frames = []
              for seq in range(npk):
                  chunk = data[seq * plen:(seq + 1) * plen]
                  real = len(chunk)
                  chunk = chunk.ljust(plen, b'\x00')
                  hdr = struct.pack(HDR_FMT, seq, npk, self.width, self.height,
                                    self.channels, real, img_id)
                  body = hdr + chunk
                  body += struct.pack('>I', zlib.crc32(body) & 0xFFFFFFFF)
                  tx = np.frombuffer(body, dtype=np.uint8) ^ whiten
                  nib = np.empty(2 * len(tx), dtype=np.uint8)
                  nib[0::2] = tx >> 4
                  nib[1::2] = tx & 15
                  frames.append(np.concatenate((PREAMBLE, nib, GUARD)))
              self.frame_all = np.concatenate(frames).astype(np.uint8)
              print('[TX] %d bytes -> %d paquetes de %d B; trama = %d simbolos; '
                    'ciclo completo = %d simbolos (~%.1f s a 8 ksym/s); id=0x%04X'
                    % (len(data), npk, plen, len(frames[0]), len(self.frame_all),
                       len(self.frame_all) / 8000.0, img_id))

          def work(self, input_items, output_items):
              if self.frame_all is None:
                  self._prepare_frames()
              out = output_items[0]
              n = len(out)
              if n < 1:
                  return 0
              L = len(self.frame_all)
              pos = (self.position + np.arange(n, dtype=np.int64)) % L
              out[:] = self.frame_all[pos]
              self.position = (self.position + n) % L
              return n

    image_path: image_path
    width: img_width
    height: img_height
    channels: img_channels
    payload_len: payload_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 270.0
    rotation: 0
    state: enabled
    _io_cache: '(''TX imagen: tramas + CRC32'', ''blk'', [(''image_path'', "''uis_logo.png''"), (''width'', ''160''), (''height'',
      ''80''), (''channels'', ''3''), (''payload_len'', ''128'')], [], [(''0'', ''byte'', 1)], '''', [''image_path'', ''width'',
      ''height'', ''channels'', ''payload_len''])'
