options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Recepcion de tramas conocidas, correlacion 4 rotaciones de fase, CRC32, BER, EVM, controles AGC y EQ opcional.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: LAB_RX_16QAM_HackRF_Verificado
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LAB RX 16-QAM HackRF - BER + EVM + CRC + SINCRONIA
    window_size: (1500,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 96
    - 32.0
    rotation: 0
    state: enabled
blocks:
- name: M
  id: variable
  parameters:
    comment: ''
    value: len(tabla_de_verdad_constelacion)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 672
    - 8.0
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: ''
    value: Rs*bps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 80.0
    rotation: 0
    state: enabled
- name: Rs
  id: variable
  parameters:
    comment: ''
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 464
    - 16.0
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    comment: ''
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 568
    - 8.0
    rotation: 0
    state: enabled
- name: beta
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Roll-off beta
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.10'
    step: '0.05'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1360
    - 0.0
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters:
    comment: ''
    value: int(math.log(M,2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 856
    - 0.0
    rotation: 0
    state: enabled
- name: const_16qam
  id: variable_constellation
  parameters:
    comment: ''
    const_points: tabla_de_verdad_constelacion
    dims: '1'
    normalization: digital.constellation.POWER_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: list(range(16))
    type: calcdist
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1912
    - 20.0
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: 960 MHz, igual al Tx
    value: 960e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 488
    - 104.0
    rotation: 0
    state: enabled
- name: hackrf_rx
  id: variable
  parameters:
    comment: ''
    value: '"hackrf=0"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 288
    - 40.0
    rotation: 0
    state: enabled
- name: lo_off
  id: variable
  parameters:
    comment: ''
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
