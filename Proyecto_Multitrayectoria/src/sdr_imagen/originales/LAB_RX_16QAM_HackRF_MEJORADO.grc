    label: Amplitud de ruido AWGN
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.001'
    stop: '2.5'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1528
    - 8.0
    rotation: 0
    state: disabled
- name: radio_rate
  id: variable
  parameters:
