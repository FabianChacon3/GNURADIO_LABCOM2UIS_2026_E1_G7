    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '8'
    stop: '40'
    value: '16'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1280
    - 160.0
    rotation: 0
    state: enabled
- name: rx_vga
  id: variable_qtgui_range
  parameters:
