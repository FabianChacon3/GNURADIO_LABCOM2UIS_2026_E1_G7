- name: rx_medidor_tramas
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: Detecta preambulo, remueve giros 0/90/180/270, CRC, BER acumulada, EVM (datos conocidos).
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: "import numpy as np\nimport zlib\nfrom gnuradio import gr\n\n# 16-QAM Gray-indexed table, average symbol\
      \ energy Es = 1.\nPOINTS = np.asarray((\n    -3-3j, -3-1j, -3+3j, -3+1j,\n    -1-3j, -1-1j, -1+3j, -1+1j,\n     3-3j,\
      \  3-1j,  3+3j,  3+1j,\n     1-3j,  1-1j,  1+3j,  1+1j\n), dtype=np.complex64) / np.sqrt(10.0)\nPRE_LEN = 64\nPAY_LEN\
      \ = 48\nGUARD_LEN = 24\nPAYLOAD = b\"LAB GNU RADIO 16QAM HACKRF 2026\".ljust(PAY_LEN, b\" \")\n# Seed is fixed; TX and\
      \ RX use the same deterministic preamble.\nPREAMBLE = np.random.default_rng(20261029).integers(0, 16, PRE_LEN, dtype=np.uint8)\n\
      GUARD = np.random.default_rng(160116).integers(0, 16, GUARD_LEN, dtype=np.uint8)\nCRC = zlib.crc32(PAYLOAD).to_bytes(4,\
      \ 'big')\nPACKET = PAYLOAD + CRC\nPACKET_NIB = np.empty(2 * len(PACKET), dtype=np.uint8)\nPACKET_NIB[0::2] = np.frombuffer(PACKET,\
      \ dtype=np.uint8) >> 4\nPACKET_NIB[1::2] = np.frombuffer(PACKET, dtype=np.uint8) & 15\nFRAME = np.concatenate((PREAMBLE,\
      \ PACKET_NIB, GUARD)).astype(np.uint8)\n\n\nclass blk(gr.sync_block):\n    \"\"\"Decode known frames; show BER, EVM\
      \ and verified frame rate.\n\n    Input 0 = symbol indices from constellation_receiver_cb port 0.\n    Input 1 = synchronized,\
      \ carrier-corrected samples from port 4.\n    Outputs = float32 BER percentage, EVM percentage, valid frame percentage.\n\
      \    \"\"\"\n    def __init__(self):\n        gr.sync_block.__init__(self, name='RX tramas: BER EVM CRC32',\n      \
      \                         in_sig=[np.uint8, np.complex64],\n                               out_sig=[np.float32, np.float32,\
      \ np.float32])\n        self.pattern = FRAME[:PRE_LEN]\n        self.samples = np.empty(0, dtype=np.complex64)\n   \
      \     self.indices = np.empty(0, dtype=np.uint8)\n        self.frame_len = len(FRAME)\n        self.data_len = len(PACKET_NIB)\n\
      \        self.total_frames = 0\n        self.valid_frames = 0\n        self.bit_errors = 0\n        self.bit_total =\
      \ 0\n        self.metric_ber = -1.0\n        self.metric_evm = -1.0\n        self.metric_ok = 0.0\n        self.evm_accum\
      \ = 0.0\n        self.hamming = np.array([bin(x).count('1') for x in range(16)], dtype=np.uint8)\n        # For each\
      \ ambiguity angle, rotated RX symbol -> canonical TX symbol.\n        self.rotation_maps = []\n        for k in range(4):\n\
      \            rotated = POINTS * (1j ** k)\n            self.rotation_maps.append(np.argmin(np.abs(POINTS[:, None] -\
      \ rotated[None, :])**2,\n                                                axis=1).astype(np.uint8))\n        self.last_report\
      \ = 0\n        print('[RX] Searching 64-symbol preamble, 4 possible quarter-turn rotations.')\n        print('[RX] BER/EVM\
      \ = -1 means no fully decoded frame yet.')\n\n    def _process(self):\n        # Max 8 wrong preamble indices gives\
      \ low false-alarm probability.\n        while len(self.indices) >= PRE_LEN:\n            nstart = len(self.indices)\
      \ - PRE_LEN + 1\n            found = None\n            for p in range(nstart):\n                rxpre = self.indices[p:p+PRE_LEN]\n\
      \                for rot, lut in enumerate(self.rotation_maps):\n                    mismatch = int(np.count_nonzero(lut[rxpre]\
      \ != self.pattern))\n                    if mismatch <= 8:\n                        found = (p, rot)\n             \
      \           break\n                if found is not None:\n                    break\n            if found is None:\n\
      \                # Keep last PRE_LEN-1 indices for preambles spanning work() calls.\n                cut = nstart\n\
      \                self.indices = self.indices[cut:]\n                self.samples = self.samples[cut:]\n            \
      \    break\n            p, rot = found\n            if len(self.indices) - p < self.frame_len:\n                if p:\n\
      \                    self.indices = self.indices[p:]\n                    self.samples = self.samples[p:]\n        \
      \        break  # Full frame has not yet arrived.\n            data_start = p + PRE_LEN\n            data_end = data_start\
      \ + self.data_len\n            recovered = self.rotation_maps[rot][self.indices[data_start:data_end]]\n            raw\
      \ = np.bitwise_or(recovered[0::2] << 4, recovered[1::2]).astype(np.uint8).tobytes()\n            payload = raw[:PAY_LEN]\n\
      \            rx_crc = raw[PAY_LEN:PAY_LEN+4]\n            crc_ok = (zlib.crc32(payload).to_bytes(4, 'big') == rx_crc)\n\
      \            verified = crc_ok and payload == PAYLOAD\n            bit_errors = int(np.sum(self.hamming[np.bitwise_xor(recovered,\
      \ PACKET_NIB)]))\n            self.bit_errors += bit_errors\n            self.bit_total += self.data_len * 4\n     \
      \       self.total_frames += 1\n            if verified:\n                self.valid_frames += 1\n            self.metric_ber\
      \ = 100.0 * self.bit_errors / max(self.bit_total, 1)\n            self.metric_ok = 100.0 * self.valid_frames / self.total_frames\n\
      \            # Data-aided EVM, with estimated complex scalar channel gain/phase.\n            # It uses the *known transmitted\
      \ symbols*, including erroneous decisions.\n            rx_samples = self.samples[data_start:data_end].astype(np.complex128)\n\
      \            reference = POINTS[PACKET_NIB].astype(np.complex128) * (1j ** rot)\n            coefficient = np.vdot(reference,\
      \ rx_samples) / (np.vdot(reference, reference) + 1e-15)\n            estimate = coefficient * reference\n          \
      \  energy = np.sum(np.abs(estimate) ** 2)\n            if energy > 1e-12:\n                evm = 100.0 * np.sqrt(np.sum(np.abs(rx_samples\
      \ - estimate)**2) / energy)\n                self.evm_accum += float(evm)\n                self.metric_evm = self.evm_accum\
      \ / self.total_frames\n            if self.total_frames == 1 or self.total_frames - self.last_report >= 50:\n      \
      \          print('[RX] frames=%d ok=%d (%.1f%%), BER=%.4f%%, EVM=%.2f%%, rot=%d, CRC=%s, mensaje=%s' % (\n         \
      \           self.total_frames, self.valid_frames, self.metric_ok, self.metric_ber,\n                    self.metric_evm,\
      \ rot * 90, 'OK' if crc_ok else 'ERROR',\n                    payload.decode('ascii', errors='replace').strip()))\n\
      \                self.last_report = self.total_frames\n            # Discard processed frame; the guard is inside it.\n\
      \            end = p + self.frame_len\n            self.indices = self.indices[end:]\n            self.samples = self.samples[end:]\n\
      \n    def work(self, input_items, output_items):\n        n = min(len(input_items[0]), len(input_items[1]),\n      \
      \          *(len(v) for v in output_items))\n        if n <= 0:\n            return 0\n        self.indices = np.concatenate((self.indices,\
      \ np.asarray(input_items[0][:n], dtype=np.uint8)))\n        self.samples = np.concatenate((self.samples, np.asarray(input_items[1][:n],\
      \ dtype=np.complex64)))\n        self._process()\n        output_items[0][:n] = self.metric_ber\n        output_items[1][:n]\
      \ = self.metric_evm\n        output_items[2][:n] = self.metric_ok\n        return n\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2280
    - 400.0
    rotation: 0
    state: enabled
    _io_cache: '(''RX tramas: BER EVM CRC32'', ''blk'', [], [(''0'', ''byte'', 1), (''1'', ''complex'', 1)], [(''0'', ''float'',
      1), (''1'', ''float'', 1), (''2'', ''float'', 1)], '''', [])'
- name: ecualizador_lms_opcional
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: 0=paso transparente. 1=prueba LMS decision-directed, no usar hasta lograr lock.
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n    \"\"\"Optional symbol-rate\
      \ normalized LMS equalizer. Disabled by default.\n\n    Experimental: it makes hard 16-QAM decisions without pilots\
      \ and therefore\n    may FAIL before carrier/AGC convergence. Keep enabled=0 for baseline.\n    \"\"\"\n    def __init__(self,\
      \ enabled=0, mu=0.001, ntaps=7):\n        gr.sync_block.__init__(self, name='EQ LMS opcional - desactivado',\n     \
      \                          in_sig=[np.complex64], out_sig=[np.complex64])\n        self.enabled = int(enabled)\n   \
      \     self.mu = float(mu)\n        self.ntaps = int(ntaps)\n        self.history = np.zeros(self.ntaps, dtype=np.complex64)\n\
      \        self.weights = np.zeros(self.ntaps, dtype=np.complex64)\n        self.weights[self.ntaps // 2] = 1\n      \
      \  self.points = np.asarray((\n            -3-3j, -3-1j, -3+3j, -3+1j,\n            -1-3j, -1-1j, -1+3j, -1+1j,\n  \
      \           3-3j,  3-1j,  3+3j,  3+1j,\n             1-3j,  1-1j,  1+3j,  1+1j), np.complex64) / np.sqrt(10.0)\n\n \
      \   def work(self, input_items, output_items):\n        inp = input_items[0]\n        out = output_items[0]\n      \
      \  n = min(len(inp), len(out))\n        if self.enabled == 0:\n            out[:n] = inp[:n]\n            return n\n\
      \        for i in range(n):\n            self.history[1:] = self.history[:-1]\n            self.history[0] = inp[i]\n\
      \            y = np.vdot(self.weights, self.history)\n            out[i] = y\n            target = self.points[np.argmin(np.abs(self.points\
      \ - y))]\n            error = target - y\n            denom = np.vdot(self.history, self.history).real + 1e-8\n    \
      \        self.weights += self.mu * np.conjugate(error) * self.history / denom\n        return n"
    enabled: '0'
    mu: '0.001'
    ntaps: '7'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1540
    - 770.0
    rotation: 0
    state: enabled
    _io_cache: ('EQ LMS opcional - desactivado', 'blk', [('enabled', '0'), ('mu', '0.001'), ('ntaps', '7')], [('0', 'complex',
      1)], [('0', 'complex', 1)], '', ['enabled', 'mu', 'ntaps'])
