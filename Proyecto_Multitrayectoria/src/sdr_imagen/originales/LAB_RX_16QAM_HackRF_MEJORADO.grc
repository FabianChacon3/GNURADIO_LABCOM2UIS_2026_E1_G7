  id: variable_rrc_filter_taps
  parameters:
    alpha: beta
    comment: ''
    gain: Sps
    ntaps: span*Sps
    samp_rate: samp_rate
    sym_rate: Rs
    value: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 0.0
    rotation: 0
    state: enabled
