options:
  parameters:
    author: Comunicaciones II - E3T
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: "Plantilla de instrumentaci\xF3n. Copie los dos Embedded Python Blocks,\
      \ variables y Vector Sink al GRC de su sistema."
    copyright: ''
    description: "Instrumentaci\xF3n BER vs Eb/N0 para sistemas SDR funcionales con\
      \ USRP o HackRF."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: BER_SDR_INSTRUMENTACION_BASE
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "BER SDR - Instrumentaci\xF3n base"
    window_size: (1500,850)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

